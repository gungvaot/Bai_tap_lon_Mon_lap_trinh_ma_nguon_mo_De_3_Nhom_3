              "script": {
                "type": "text/javascript",
                "exec": [
                  "const vn = ms => new Date(Date.now() + 7*3600e3 + ms).toISOString().slice(0, 19);",
                  "pm.collectionVariables.set(\"startNow\", vn(-3600e3));",
                  "pm.collectionVariables.set(\"endNow\", vn(3600e3));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trạng thái 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"eventId\", pm.response.json().id);"
